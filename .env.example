# Coordonnées du point de prévision (Paris centre par défaut — mettez les vôtres)
ZEPHYR_LAT=48.8566
ZEPHYR_LON=2.3522

# Application Netatmo créée sur https://dev.netatmo.com (voir README, section Netatmo)
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
# Refresh token initial (scope read_station). Après le premier lancement, le token
# à jour vit dans data/netatmo_token.json ; cette valeur ne sert plus.
NETATMO_REFRESH_TOKEN=

# Pièces intérieures affichées dans le bandeau (2 max), séparées par des virgules,
# dans l'ordre d'affichage. Utiliser les noms renvoyés par l'API (module_name, ou
# station_name pour la base — souvent « X (Indoor) », l'API météo n'exposant pas
# les noms de pièces de l'app). Alias d'affichage optionnel avec « = ».
# Vide = toutes les pièces trouvées (station de base en premier).
#NETATMO_INDOOR_MODULES=Maison (Indoor)=Salon,Chambre

# Facultatif
#ZEPHYR_DATA_DIR=data
#ZEPHYR_OUT_DIR=out
